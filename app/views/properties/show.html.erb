<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Header -->
  <div class="mb-8">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-gray-900"><%= @property.name %></h1>
        <p class="mt-2 text-sm text-gray-600"><%= @property.property_type %></p>
      </div>
      <div class="flex gap-3">
        <%= link_to "Edit", edit_property_path(@property), class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50" %>
        <%= button_to "Delete", @property, method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-red-600 hover:bg-red-700" %>
      </div>
    </div>
  </div>

  <!-- Property Details -->
  <div class="bg-white shadow rounded-lg mb-8">
    <div class="px-4 py-5 sm:p-6">
      <h3 class="text-lg font-medium leading-6 text-gray-900 mb-4">Property Details</h3>
      <dl class="grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2">
        <div>
          <dt class="text-sm font-medium text-gray-500">Address</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @property.address.present? ? @property.address : "Not specified" %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">Purchase Date</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @property.purchase_date ? @property.purchase_date.strftime("%B %d, %Y") : "Not specified" %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">Purchase Price</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= number_to_currency(@property.purchase_price) %></dd>
        </div>
      </dl>
    </div>
  </div>

  <!-- Financial Summary -->
  <div class="grid grid-cols-1 gap-5 sm:grid-cols-3 mb-8">
    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <dt class="text-sm font-medium text-gray-500 truncate">Total Income</dt>
        <dd class="mt-1 text-2xl font-semibold text-green-600"><%= number_to_currency(@property.total_income) %></dd>
      </div>
    </div>
    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <dt class="text-sm font-medium text-gray-500 truncate">Total Expenses</dt>
        <dd class="mt-1 text-2xl font-semibold text-red-600"><%= number_to_currency(@property.total_expenses) %></dd>
      </div>
    </div>
    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <dt class="text-sm font-medium text-gray-500 truncate">Net Cash Flow</dt>
        <dd class="mt-1 text-2xl font-semibold <%= @property.net_cash_flow >= 0 ? 'text-green-600' : 'text-red-600' %>">
          <%= number_to_currency(@property.net_cash_flow) %>
        </dd>
      </div>
    </div>
  </div>

  <!-- Recent Transactions -->
  <div class="bg-white shadow rounded-lg">
    <div class="px-4 py-5 sm:px-6 flex justify-between items-center">
      <h3 class="text-lg leading-6 font-medium text-gray-900">Recent Transactions</h3>
      <%= link_to "Add Transaction", new_property_transaction_path(@property), class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700" %>
    </div>
    <div class="border-t border-gray-200">
      <% if @transactions.any? %>
        <ul role="list" class="divide-y divide-gray-200">
          <% @transactions.each do |transaction| %>
            <li class="px-4 py-4 sm:px-6">
              <div class="flex items-center justify-between">
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium text-gray-900"><%= transaction.category %></p>
                  <p class="text-sm text-gray-500">
                    <%= transaction.date.strftime("%b %d, %Y") %>
                    <% if transaction.description.present? %>
                      • <%= transaction.description %>
                    <% end %>
                  </p>
                </div>
                <div class="ml-5 flex items-center gap-4">
                  <span class="text-sm font-medium <%= transaction.transaction_type == 'income' ? 'text-green-600' : 'text-red-600' %>">
                    <%= transaction.transaction_type == 'income' ? '+' : '-' %><%= number_to_currency(transaction.amount) %>
                  </span>
                  <div class="flex gap-2">
                    <%= link_to "Edit", edit_property_transaction_path(@property, transaction), class: "text-indigo-600 hover:text-indigo-900 text-sm" %>
                    <%= button_to "Delete", property_transaction_path(@property, transaction), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "text-red-600 hover:text-red-900 text-sm" %>
                  </div>
                </div>
              </div>
            </li>
          <% end %>
        </ul>
        <div class="px-4 py-3 bg-gray-50 text-right sm:px-6">
          <%= link_to "View all transactions", property_transactions_path(@property), class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
        </div>
      <% else %>
        <div class="text-center py-12">
          <p class="text-sm text-gray-500">No transactions yet.</p>
          <div class="mt-4">
            <%= link_to "Add Transaction", new_property_transaction_path(@property), class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
